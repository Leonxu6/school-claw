{
  "name": "school-claw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:scope": "vitest run tests/scope-get.test.ts",
    "test:scoped-read": "vitest run tests/scoped-read.test.ts",
    "test:artifact": "vitest run tests/artifact.test.ts",
    "test:write-audit": "vitest run tests/write-audit.test.ts",
    "test:scope-bridge": "vitest run tests/scope-bridge.test.ts",
    "typecheck": "tsc --noEmit",
    "demo:scope": "tsx scripts/demo-scope.ts",
    "demo:scoped-read": "tsx scripts/demo-scoped-read.ts",
    "demo:artifact": "tsx scripts/demo-artifact.ts",
    "demo:write-audit": "tsx scripts/demo-write-audit.ts",
    "demo:scope-bridge": "tsx scripts/demo-scope-bridge.ts",
    "demo:openclaw-read": "node --import ./node_modules/tsx/dist/esm/index.mjs scripts/demo-openclaw-read.ts",
    "demo:sedimentation": "node --import ./node_modules/tsx/dist/esm/index.mjs scripts/demo-sedimentation.ts",
    "demo:capability-harness": "node --import ./node_modules/tsx/dist/esm/index.mjs scripts/demo-capability-harness.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^22.15.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
